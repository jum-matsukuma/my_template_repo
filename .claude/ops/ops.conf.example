# Ops configuration for the unattended daily jobs.
#
#   cp ops.conf.example ops.conf     # ops.conf is gitignored: it holds machine paths
#
# Every job script sources this file. Nothing here is competition-specific until
# you fill it in, which is what makes the harness reusable across competitions.

# Absolute path to the repository the jobs operate on. launchd starts with an
# empty environment and no working directory, so this cannot be relative.
REPO="/absolute/path/to/your-competition-repo"

# Kaggle competition slug (the URL suffix).
COMP="your-competition-slug"

# Prefix for LaunchAgent labels and branch names. Keep it short and unique per
# competition so two competitions on one machine never collide.
PREFIX="mycomp"

# Where kaggle_research.py writes. Relative to REPO.
OUT_DIR="research"

# Last day the jobs should run, YYYY-MM-DD. Past this date the runner
# self-uninstalls its LaunchAgents. Set it a couple of days after the
# competition deadline -- an unattended job that outlives its purpose is a
# machine you have to remember to clean up, and you will not remember.
STOP_DATE="2099-12-31"

# Paths committed when the fetch finds a diff, space-separated, relative to REPO.
#
# Deliberately excludes research/notebooks/: that is other people's source code,
# and redistributing it through your repository is a licensing question you do
# not want to answer by accident. Discussion text and writeups are included
# because the whole point of the job is to make their changes reviewable in a
# diff -- if that is too much for your situation, drop them here and keep only
# the manifest, which still records that something changed.
COMMIT_PATHS="research/discussions research/writeups research/kernel_comments research/manifest.json"

# Extra flags for kaggle_research.py. Leave empty for full enumeration, which
# is the safe default. --top-topics N is faster but builds a permanent blind
# spot; see the script's docstring before reaching for it.
FETCH_ARGS=""

# Optional: raises the r.jina.ai rate limit for writeup body fetches.
# Leave unset to use the keyless tier. Never commit a real key.
# JINA_API_KEY=""

# --- translate job (日本語訳) ----------------------------------------------
#
# Off by default: it is the only daily job that spends model tokens per
# document, so opting in should be a decision rather than a template default.
# Turn it on, then re-run ./install.sh to register the LaunchAgent.
TRANSLATE_ENABLED=0

# Where the Japanese translations land. HUMAN-FACING ONLY -- agents read the
# English originals under $OUT_DIR/rendered/ instead, and .claude/settings.json
# denies Read on this directory to keep that mechanical. See .claude/ops/README.md.
JA_DIR="docs/research-ja"

# How many documents a single nightly run translates. Each one is a separate
# bounded agent, so this is the per-night cost dial. A backlog drains over
# several nights; nothing is lost by keeping it small.
TRANSLATE_MAX_PER_RUN=5

# How many discussion pages a single run renders through r.jina.ai. Rendering is
# cheap but rate-limited; the cap keeps one night's run from stalling on it.
TRANSLATE_PREP_LIMIT=40

# Extra flags for `research_ja.py prep`. The default selection is
# "any thread whose title looks like a solution writeup, plus anything at or
# above --min-votes (20)". Widen with --min-votes 5, or --all-topics to render
# every tracked thread (expensive: every one becomes a translation candidate).
#   TRANSLATE_ARGS="--min-votes 10 --topic 733154"
TRANSLATE_ARGS=""

# Browsable HTML export of the translations (figures inlined, dark/light aware).
# Written outside the repo so it is never committed by accident.
TRANSLATE_HTML=1
TRANSLATE_HTML_DIR="$HOME/Downloads/${PREFIX}-research-ja"

# Paths the translate job commits. Includes research/rendered and research/assets
# because the translation is meaningless without the English original it was made
# from and the figures both sides point at.
TRANSLATE_PATHS="docs/research-ja research/rendered research/assets research/translate_manifest.json"
