<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by install.sh; edit that or ops.conf, not the installed copy. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@@LABEL@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>@@OPS_DIR@@/run-daily.sh @@JOB@@</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>@@HOUR@@</integer>
    <key>Minute</key><integer>@@MINUTE@@</integer>
  </dict>
  <key>StandardOutPath</key><string>@@OPS_DIR@@/logs/@@JOB@@.launchd.out</string>
  <key>StandardErrorPath</key><string>@@OPS_DIR@@/logs/@@JOB@@.launchd.err</string>
  <!-- RunAtLoad false: installing at 14:00 should not trigger the 03:03 job. -->
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
